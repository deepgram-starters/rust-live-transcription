# Required
DEEPGRAM_API_KEY=%api_key%

# Optional (defaults shown)
# Backend API server port
PORT=8081
# Server host
HOST=0.0.0.0

# Session auth (set in production to enable nonce validation)
# SESSION_SECRET=%session_secret%

# Advanced: use a custom Deepgram-compatible endpoint. HTTPS/WSS is required so
# the API key is not sent in plaintext. For a local test server only, also set
# DEEPGRAM_ALLOW_INSECURE_BASE_URL=1.
# DEEPGRAM_BASE_URL=https://api.deepgram.com/
